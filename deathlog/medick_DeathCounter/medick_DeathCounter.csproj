<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>medick_DeathCounter</AssemblyName>
    <RootNamespace>medick_DeathCounter</RootNamespace>
    <Version>0.1.13</Version>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- tests/ builds on its own (CoreTests: game-free unit tests) -->
  <ItemGroup>
    <Compile Remove="src\Compatibility\NullableAttribute.cs" Condition="'$(NoGame)' == 'true'" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="docs\**\*.cs" />
    <Compile Remove="mockups\**\*.cs" />
  </ItemGroup>

  <!--
    The mod references NO game assembly (every Last Epoch type is reached by
    name, see src/Game/Refl.cs), so it can be built two ways:

    Default:  against the MelonLoader + Unity DLLs inside your game install.
    NoGame:   dotnet build -c Release -p:NoGame=true
              against the same libraries from NuGet, at the versions
              MelonLoader 0.7.2 ships (Il2CppInterop 1.5.1, HarmonyX 2.10.2).
              Used by CI and by machines without the game.
  -->

  <PropertyGroup>
    <ML>C:\Program Files (x86)\Steam\steamapps\common\Last Epoch\MelonLoader\net6\</ML>
    <GM>C:\Program Files (x86)\Steam\steamapps\common\Last Epoch\MelonLoader\Il2CppAssemblies\</GM>
  </PropertyGroup>

  <ItemGroup Condition="'$(NoGame)' != 'true'">
    <Reference Include="Mono.Cecil"><HintPath>$(ML)Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(ML)MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ML)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(ML)Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GM)Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GM)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GM)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GM)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GM)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(NoGame)' == 'true'">
    <DeployToMods>false</DeployToMods>
    <NoWarn>$(NoWarn);NU1701;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(NoGame)' == 'true'">
    <PackageReference Include="Mono.Cecil" Version="0.11.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.10.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Auto-copy built DLL to Last Epoch Mods folder after each build (-p:DeployToMods=false to skip) -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(DeployToMods)' != 'false'">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\Last Epoch\Mods\" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="src\Core\Data\boss-harbinger.runtime.json" LogicalName="medick_DeathCounter.BossResearchCatalog.json" />
    <EmbeddedResource Include="src\Core\Data\boss-guide-moves.runtime.json" LogicalName="medick_DeathCounter.BossGuideMoves.json" />
    <EmbeddedResource Include="src\Core\Data\boss-maxroll-player.runtime.json" LogicalName="medick_DeathCounter.MaxrollPlayerNotes.json" />
    <Compile Include="..\tools\TerribleInteropRepair\CoreModuleRepair.cs" Link="Compatibility\CoreModuleRepair.cs" />
    <Compile Include="..\tools\TerribleInteropRepair\EmbeddedRepairBootstrap.cs" Link="Compatibility\EmbeddedRepairBootstrap.cs" />
  </ItemGroup>
</Project>





